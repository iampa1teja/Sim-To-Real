<robot name="bad_mimic_of_mimic"><link name="A"/><link name="B"/><link name="C"/><link name="D"/><joint name="J1" type="prismatic"><parent link="A"/><child link="B"/>
 <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
 <limit lower="0" upper=".1" effort="15" velocity="0.2"/></joint><joint name="J2" type="prismatic"><parent link="B"/><child link="C"/>
 <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
 <limit lower="0" upper=".1" effort="15" velocity="0.2"/><mimic joint="J1"/></joint><joint name="J3" type="prismatic"><parent link="C"/><child link="D"/>
 <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
 <limit lower="0" upper=".1" effort="15" velocity="0.2"/><mimic joint="J2"/></joint></robot>
