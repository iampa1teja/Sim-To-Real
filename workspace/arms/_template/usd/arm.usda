#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Robot" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
{
    def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 0.5
        def Cube "body" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            double size = 0.05
        }
    }
    def Xform "tool" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        double3 xformOp:translate = (0, 0, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.1
        def Cube "body" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            double size = 0.04
        }
    }
    def Xform "finger_link" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        double3 xformOp:translate = (0.04, 0, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.02
        def Cube "body" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            double size = 0.01
        }
    }
    def PhysicsFixedJoint "world_fixed"
    {
        rel physics:body1 = </Robot/base>
    }
    def PhysicsRevoluteJoint "Shoulder"
    {
        rel physics:body0 = </Robot/base>
        rel physics:body1 = </Robot/tool>
        uniform token physics:axis = "Y"
        point3f physics:localPos0 = (0, 0, 0.12)
        float physics:lowerLimit = -180
        float physics:upperLimit = 180
    }
    def PhysicsPrismaticJoint "Finger"
    {
        rel physics:body0 = </Robot/tool>
        rel physics:body1 = </Robot/finger_link>
        uniform token physics:axis = "X"
        point3f physics:localPos0 = (0.02, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.04
    }
}
