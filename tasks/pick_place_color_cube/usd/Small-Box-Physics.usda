#usda 1.0
(
    defaultPrim = "SmallBox"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SmallBox" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    float3[] extent = [(-0.025, -0.025, 0), (0.025, 0.025, 0.035)]
    bool physics:rigidBodyEnabled = true
    bool physics:kinematicEnabled = true

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        bool physics:collisionEnabled = true
        double3 xformOp:translate = (0, 0, 0.001)
        double3 xformOp:scale = (0.05, 0.05, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Left" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        bool physics:collisionEnabled = true
        double3 xformOp:translate = (-0.0225, 0, 0.0185)
        double3 xformOp:scale = (0.005, 0.05, 0.033)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Right" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        bool physics:collisionEnabled = true
        double3 xformOp:translate = (0.0225, 0, 0.0185)
        double3 xformOp:scale = (0.005, 0.05, 0.033)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Front" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        bool physics:collisionEnabled = true
        double3 xformOp:translate = (0, -0.0225, 0.0185)
        double3 xformOp:scale = (0.04, 0.005, 0.033)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Back" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        bool physics:collisionEnabled = true
        double3 xformOp:translate = (0, 0.0225, 0.0185)
        double3 xformOp:scale = (0.04, 0.005, 0.033)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
