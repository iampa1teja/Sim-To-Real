# Copy to .env and set the ports, device IDs and camera indices for your setup.
S2R_ARM=so101
S2R_SCENE=rpd_meeting_room
S2R_TASK=pick_place_cube
TELEOP_PORT=/dev/ttyACM0
ROBOT_PORT=/dev/ttyACM1
TELEOP_ID=leader_arm_1
ROBOT_ID=follower_arm_1
CAMERA_GRIPPER=0
CAMERA_EXTERNAL=2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FOURCC=MJPG
