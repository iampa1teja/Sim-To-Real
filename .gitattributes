# Keep LF line endings in the repo so scripts work in the Linux containers.
* text=auto eol=lf

*.png binary
*.jpg binary
*.usd binary
*.usdc binary
*.usdz binary
*.pt binary
*.safetensors binary

# Imported ROS source bytes are provenance; do not rewrite line endings on checkout.
arms/*/source/** -text whitespace=-blank-at-eol
arms/*/urdf/** -text whitespace=-blank-at-eol
