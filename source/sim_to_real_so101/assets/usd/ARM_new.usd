#usda 1.0
(
    defaultPrim = "so101_new_calib"
    doc = "Original SO-101 wrist neutral frame for Molmo evaluation. Removes the baked 90-degree wrist-roll offset; the source asset remains unchanged."
    metersPerUnit = 1
    subLayers = [
        @SO-ARM101-USD.usd@
    ]
    upAxis = "Z"
)

# Restore the five wrist/gripper properties from the initial-release asset.
# Keep joint anchors and the authored zero-pose link transforms consistent.
over "so101_new_calib"
{
    over "joints"
    {
        over "Wrist_Roll"
        {
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "gripper"
    {
        quatd xformOp:orient = (0.5000019669532776, -0.49999964237213135, -0.5000036358833313, -0.4999951124191284)
        double3 xformOp:translate = (0.02061525173485279, -0.2774733006954193, 0.2668520510196686)
    }

    over "jaw"
    {
        quatd xformOp:orient = (0.7071079611778259, 0.0000029206275939941406, -0.7071058750152588, 0.0000073015689849853516)
        double3 xformOp:translate = (0.03941557556390762, -0.3008729815483093, 0.2870521545410156)
    }
}
