#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 1
    upAxis = "Z"
)

# Compose out the preview robot/cameras BEFORE Isaac Lab registers callbacks.
# The agent spawns one controlled articulation and three live camera sensors.
def Xform "Room" (
    prepend references = @digital_twin.usdz@</RealSetup>
)
{
    over "Robot" (active = false) {}
    over "realsense_camera_rgb" (active = false) {}
    over "realsense_camera_depth" (active = false) {}
}
